"μετασχηματισμού επιλογής."

#: src/ui/settings/llm.rs:222
msgid "Active preset"
msgstr "Ενεργή προρύθμιση"

#: src/ui/settings/llm.rs:228
msgid "Name"
msgstr "Όνομα"

#: src/ui/settings/llm.rs:238
msgid "Add"
msgstr "Προσθήκη"

#: src/ui/settings/llm.rs:239
msgid "Duplicate"
msgstr "Διπλασιασμός"

#: src/ui/settings/llm.rs:251
msgid "Prompt"
msgstr "Οδηγία"

#: src/ui/settings/llm.rs:253
#, rust-format
msgid ""
"The system instruction sent with the transcript. For translate presets, the "
