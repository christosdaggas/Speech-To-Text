msgstr "Χαμηλότερη = πιο ντετερμινιστικό"

#: src/ui/settings/llm.rs:197
msgid "Test connection"
msgstr "Δοκιμή σύνδεσης"

#: src/ui/settings/llm.rs:205 src/ui/settings/microphone.rs:166
msgid "Test"
msgstr "Δοκιμή"

#: src/ui/settings/llm.rs:216
msgid "Prompt Presets"
msgstr "Προρυθμίσεις οδηγιών"

#: src/ui/settings/llm.rs:218
msgid ""
"Reusable instructions for the LLM. The active preset is used by \"Improve "
"with AI\", the mini panel and the transform-selection shortcut."
msgstr ""
"Επαναχρησιμοποιήσιμες οδηγίες για το LLM. Η ενεργή προρύθμιση "
